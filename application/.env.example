# Firebase web config (Firebase console > Project settings > Your apps). Public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Service-account key, relative to application/. Never commit it.
FIREBASE_SA_FILE=secrets/your-firebase-adminsdk.json

PORT=4000
ML_URL=http://localhost:8000
ML_INTERNAL_KEY=change-me
CORS_ORIGIN=http://localhost:5173
# MARKET_MODE=synthetic   # force labelled demo prices instead of Yahoo
